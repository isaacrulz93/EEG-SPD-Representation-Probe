.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# MOABB/MNE downloads and all regenerable caches
cache/*
!cache/.gitkeep
mne_data/
MNE-*-data/
raw/
data/raw/

# Large numerical artifacts are regenerated by the scripts
*.npy
*.npz
*.pt
*.pth
*.ckpt
*tsne*cache*
*t-SNE*cache*

# Small, preregistered Trajectory Anatomy v0 null-summary artifacts
!outputs/bnci2014_001_trajectory_v0/nulls/order_shuffle_group_stats.npz
!outputs/bnci2014_001_trajectory_v0/nulls/label_null_group_stats.npz

# Compact, preregistered Trajectory Within-Subject Audit v1 null statistics
!outputs/bnci2014_001_trajectory_within_subject_v1/nulls/label_null_statistics.npz
!outputs/bnci2014_001_trajectory_within_subject_v1/nulls/order_null_statistics.npz

# Compact Stage-2A quotient-consensus prototypes and frozen null statistics
!outputs/bnci2014_001_local_gpa_consensus_v0/objects/consensus_prototypes.npz
!outputs/bnci2014_001_local_gpa_consensus_v0/nulls/correspondence_null_statistics.npz
!outputs/bnci2014_001_local_gpa_consensus_v1/objects/consensus_prototypes.npz
!outputs/bnci2014_001_local_gpa_consensus_v1/nulls/correspondence_null_statistics.npz
!outputs/bnci2014_001_local_gpa_outer_convergence_audit_v2/traces/outer_loop_traces.npz

# Compact frozen-matrix anatomy outputs (no refitted movement objects)
!outputs/bnci2014_001_angular_relation_anatomy_v0/arrays/relation_anatomy_matrices.npz

# Local scratch files
*.tmp
*.temp
*.log

# Resumable Baseline Trajectory V0 scratch chunks (aggregate CSVs are tracked)
outputs/bnci2014_001_baseline_trajectory_identifiability_v0/action_bridge/chunks/
